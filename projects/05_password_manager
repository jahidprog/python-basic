import json

FILE_NAME = "passwords.json"


def load_passwords():
    try:
        with open(FILE_NAME, "r") as file:
            return json.load(file)
    except FileNotFoundError:
        return []


def save_passwords(passwords):
    with open(FILE_NAME, "w") as file:
        json.dump(passwords, file, indent=4)


def add_password(passwords):
    website = input("Website: ")
    username = input("Username: ")
    password = input("Password: ")

    account = {
        "website": website,
        "username": username,
        "password": password
    }

    passwords.append(account)
    save_passwords(passwords)

    print("✅ Account saved!")


def view_passwords(passwords):
    if not passwords:
        print("No saved accounts.")
        return

    print("\n--- Saved Accounts ---")

    for i, account in enumerate(passwords, start=1):
        print(f"\n{i}. {account['website']}")
        print(f"   Username: {account['username']}")
        print(f"   Password: {account['password']}")


def search_password(passwords):
    website = input("Enter website to search: ").lower()

    found = False

    for account in passwords:
        if account["website"].lower() == website:
            print("\nAccount found!")
            print(f"Website: {account['website']}")
            print(f"Username: {account['username']}")
            print(f"Password: {account['password']}")

            found = True
            break

    if not found:
        print("❌ Account not found.")


def delete_password(passwords):
    website = input("Enter website to delete: ").lower()

    for account in passwords:
        if account["website"].lower() == website:
            passwords.remove(account)
            save_passwords(passwords)

            print("🗑️ Account deleted!")
            return

    print("❌ Account not found.")


def main():
    passwords = load_passwords()

    while True:
        print("\n===== Password Manager =====")
        print("1. Add Password")
        print("2. View Passwords")
        print("3. Search Password")
        print("4. Delete Password")
        print("5. Exit")

        choice = input("Choose an option: ")

        if choice == "1":
            add_password(passwords)

        elif choice == "2":
            view_passwords(passwords)

        elif choice == "3":
            search_password(passwords)

        elif choice == "4":
            delete_password(passwords)

        elif choice == "5":
            print("Goodbye 👋")
            break

        else:
            print("❌ Invalid option.")


if __name__ == "__main__":
    main()